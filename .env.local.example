# Copy this file to .env.local and fill in your Supabase project credentials
# (Project Settings -> API in the Supabase dashboard)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never exposed to the browser. Same page: Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — get yours at https://console.anthropic.com. Powers the AI
# Teacher, Writing Coach, and placement-test scoring (added in a later phase).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Get these at https://dashboard.stripe.com (Developers -> API keys). Use
# test-mode keys (pk_test_.../sk_test_...) for local development.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# From Developers -> Webhooks once a webhook endpoint is configured.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Azure AI Speech (Pronunciation Assessment) — create a "Speech" resource at
# https://portal.azure.com, then Keys and Endpoint on that resource.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region

# Resend (streak-reminder emails) — https://resend.com/signup, then
# Dashboard -> API Keys. Sandbox accounts can only send to your own address
# until you verify a sending domain at resend.com/domains.
RESEND_API_KEY=your-resend-api-key

# Web Push VAPID key pair — generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Random secret Vercel Cron sends as a Bearer token to authenticate
# /api/cron/reminders — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret

# Optional — production error monitoring. Sign up free at https://sentry.io,
# create a Next.js project, and copy the DSN from Settings -> Client Keys
# (DSN). Leave unset to disable error monitoring entirely (no code changes
# needed either way — it's a safe no-op without this).
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
